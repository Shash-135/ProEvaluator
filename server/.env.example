PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI (Replace with your MongoDB Atlas Cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pro_evaluator?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_antigravity_2026
JWT_REFRESH_SECRET=super_secret_refresh_key_antigravity_2026

# OAuth Secrets (Optional for dev, required for live Google/GitHub login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# GitHub Personal Access Token (Optional fallback for Octokit metric fetches)
GITHUB_TOKEN=your_github_pat_token_here
